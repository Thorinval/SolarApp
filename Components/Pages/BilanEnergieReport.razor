@page "/bilan-energie"
@using System.Globalization
@using SolarApp.Data
@using SolarApp.Models
@using Microsoft.EntityFrameworkCore
@inject AtmocDbContext DbContext
@rendermode InteractiveServer

<PageTitle>Bilan énergie solaire</PageTitle>

<div class="container-fluid py-4">
	<h1 class="mb-4">Bilan énergie solaire</h1>

	@if (isLoading)
	{
		<div class="alert alert-info">Chargement...</div>
	}
	else if (blocks.Count == 0)
	{
		<div class="alert alert-warning">Aucune donnée de bilan énergie disponible.</div>
	}
	else
	{
		<div class="accordion bilan-accordion" id="bilanAccordion">
			@foreach (var block in blocks)
			{
				var isExpanded = expandedBlocks.Contains(block.Title);
				<div class="accordion-item bilan-accordion-item">
					<h2 class="accordion-header">
						<button 
							class="accordion-button @(!isExpanded ? "collapsed" : "")" 
							type="button" 
							@onclick="@(() => ToggleBlock(block.Title))">
							@block.Title
						</button>
					</h2>
					<div 
						id="collapse-@block.Title" 
						class="accordion-collapse collapse @(isExpanded ? "show" : "")" 
						data-bs-parent="#bilanAccordion">
						<div class="accordion-body p-0">
							<div class="table-responsive">
								<table class="table table-striped table-sm align-middle bilan-energie-table">
									<thead>
										<tr>
											<th style="width: 150px;">@headers[1]</th>
											@for (var i = 2; i < headers.Count; i++)
											{
												<th>@headers[i]</th>
											}
										</tr>
									</thead>
									<tbody>
										@foreach (var row in block.Rows)
										{
											<tr class="@(GetRowClass(row))">
												<td class="text-start @(row.IsTotal ? "fw-bold" : "")">
													@if (row.IsTotal)
													{
														<text>Total</text>
													}
													else
													{
														@row.Month
													}
												</td>

												@for (var i = 2; i < headers.Count; i++)
												{
													<td class="text-end @GetCellClass(row.Cells[i]) @(row.IsTotal ? "fw-bold" : "")">@row.Cells[i]</td>
												}
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>

@code {
	private readonly CultureInfo frCulture = CultureInfo.GetCultureInfo("fr-FR");
	private List<string> headers = new();
	private List<BlockData> blocks = new();
	private bool isLoading = true;
	private HashSet<string> expandedBlocks = new();

	protected override async Task OnInitializedAsync()
	{
		headers =
		[
			"Année",
			"Mois",
			"Produit (kWh)",
			"Consommé (kWh)",
			"Depuis réseau (kWh)",
			"Vers réseau (kWh)",
			"Chargé (kWh)",
			"Déchargé (kWh)",
			"Autonomie (%)",
			"J sans SOC max",
			"J avec SOC min"
		];

		await LoadFromMonthlySourceAsync();
	}

	private async Task LoadFromMonthlySourceAsync()
	{
		isLoading = true;
		try
		{
			var records = await DbContext.DailyEnergyRecords
				.AsNoTracking()
				.ToListAsync();

			var monthlyRows = records
				.GroupBy(r => new DateOnly(r.RecordDate.Year, r.RecordDate.Month, 1))
				.Select(g => BuildMonthlyRow(g.Key, g))
				.ToList();

			blocks = BuildBlocksByYear(monthlyRows);

			expandedBlocks.Clear();
			var currentYear = DateTime.Now.Year.ToString(frCulture);
			var currentYearBlock = blocks.FirstOrDefault(b => b.Title == currentYear);
			if (currentYearBlock is not null)
			{
				expandedBlocks.Add(currentYear);
			}
			else if (blocks.Count > 0)
			{
				expandedBlocks.Add(blocks[0].Title);
			}
		}
		finally
		{
			isLoading = false;
		}
	}

	private void ToggleBlock(string year)
	{
		if (expandedBlocks.Contains(year))
		{
			expandedBlocks.Remove(year);
		}
		else
		{
			expandedBlocks.Add(year);
		}
	}

	private MonthlySourceRow BuildMonthlyRow(DateOnly monthDate, IEnumerable<DailyEnergyRecord> monthRecords)
	{
		var producedKwh = monthRecords.Sum(x => x.ProducedKwh);
		var consumedKwh = monthRecords.Sum(x => x.ConsumedKwh);
		var fromGridKwh = monthRecords.Sum(x => x.FromGridKwh);
		var toGridKwh = monthRecords.Sum(x => x.ToGridKwh);
		var chargedKwh = monthRecords.Sum(x => x.ChargedKwh);
		var dischargedKwh = monthRecords.Sum(x => x.DischargedKwh);

		var autonomy = consumedKwh == 0
			? 0
			: (1 - (fromGridKwh / consumedKwh)) * 100;

		var daysWithoutSocMax = monthRecords.Count(x => x.SocMax < 100);
		var daysWithSocMin = monthRecords.Count(x => x.ColumnIValue <= 10);

		return new MonthlySourceRow
		{
			Year = monthDate.Year,
			MonthOrder = monthDate.Month,
			Month = CapitalizeFirstLetter(monthDate.ToDateTime(TimeOnly.MinValue).ToString("MMMM", frCulture)),
			ProducedKwh = producedKwh,
			ConsumedKwh = consumedKwh,
			FromGridKwh = fromGridKwh,
			ToGridKwh = toGridKwh,
			ChargedKwh = chargedKwh,
			DischargedKwh = dischargedKwh,
			Autonomy = autonomy,
			DaysWithoutSocMax = daysWithoutSocMax,
			DaysWithSocMin = daysWithSocMin
		};
	}

	private List<BlockData> BuildBlocksByYear(List<MonthlySourceRow> rows)
	{
		return rows
			.GroupBy(r => r.Year)
			.OrderByDescending(g => g.Key)
			.Select(g =>
			{
				var orderedRows = g.OrderByDescending(x => x.MonthOrder).ToList();
				var blockRows = orderedRows
					.Select(row => new RowVm
					{
						Cells = BuildCells(g.Key.ToString(frCulture), row),
						Month = row.Month,
						EffectiveYear = g.Key.ToString(frCulture),
						IsTotal = false
					})
					.ToList();

				var totalProduced = orderedRows.Sum(x => x.ProducedKwh);
				var totalConsumed = orderedRows.Sum(x => x.ConsumedKwh);
				var totalFromGrid = orderedRows.Sum(x => x.FromGridKwh);
				var totalToGrid = orderedRows.Sum(x => x.ToGridKwh);
				var totalCharged = orderedRows.Sum(x => x.ChargedKwh);
				var totalDischarged = orderedRows.Sum(x => x.DischargedKwh);
				var totalAutonomy = totalConsumed == 0 ? 0 : (1 - (totalFromGrid / totalConsumed)) * 100;
				var totalDaysWithoutSocMax = orderedRows.Sum(x => x.DaysWithoutSocMax);
				var totalDaysWithSocMin = orderedRows.Sum(x => x.DaysWithSocMin);

				blockRows.Add(new RowVm
				{
					Cells =
					[
						g.Key.ToString(frCulture),
						"Cumul",
						totalProduced.ToString("F2", frCulture),
						totalConsumed.ToString("F2", frCulture),
						totalFromGrid.ToString("F2", frCulture),
						totalToGrid.ToString("F2", frCulture),
						totalCharged.ToString("F2", frCulture),
						totalDischarged.ToString("F2", frCulture),
						$"{totalAutonomy:F2}%",
						totalDaysWithoutSocMax.ToString(frCulture),
						totalDaysWithSocMin.ToString(frCulture)
					],
					Month = "Cumul",
					EffectiveYear = g.Key.ToString(frCulture),
					IsTotal = true
				});

				return new BlockData { Title = g.Key.ToString(frCulture), Rows = blockRows };
			})
			.ToList();
	}

	private List<string> BuildCells(string year, MonthlySourceRow row)
	{
		return
		[
			year,
			row.Month,
			row.ProducedKwh.ToString("F2", frCulture),
			row.ConsumedKwh.ToString("F2", frCulture),
			row.FromGridKwh.ToString("F2", frCulture),
			row.ToGridKwh.ToString("F2", frCulture),
			row.ChargedKwh.ToString("F2", frCulture),
			row.DischargedKwh.ToString("F2", frCulture),
			$"{row.Autonomy:F2}%",
			row.DaysWithoutSocMax.ToString(frCulture),
			row.DaysWithSocMin.ToString(frCulture)
		];
	}

	private string CapitalizeFirstLetter(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return value;
		}

		return char.ToUpper(value[0], frCulture) + value[1..];
	}

	private static string GetRowClass(RowVm row)
	{
		if (row.IsTotal)
		{
			return "total-row";
		}
		return string.Empty;
	}

	private static string GetCellClass(string value)
	{
		var classes = new List<string>();

		if (value.Contains('%'))
		{
			classes.Add("percent-col");
			classes.Add(GetPercentStateClass(value));
		}

		return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
	}

	private static string GetPercentStateClass(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return string.Empty;
		}

		var normalized = value.Replace("%", string.Empty).Trim();
		if (!double.TryParse(normalized, System.Globalization.NumberStyles.Any, 
			System.Globalization.CultureInfo.GetCultureInfo("fr-FR"), out var percent)
			&& !double.TryParse(normalized, System.Globalization.NumberStyles.Any, 
			System.Globalization.CultureInfo.InvariantCulture, out percent))
		{
			return string.Empty;
		}

		var delta = percent - 100d;
		if (delta > 0)
		{
			if (delta >= 80) return "percent-high-3";
			if (delta >= 40) return "percent-high-2";
			return "percent-high-1";
		}

		if (delta < 0)
		{
			if (delta <= -80) return "percent-low-3";
			if (delta <= -40) return "percent-low-2";
			return "percent-low-1";
		}

		return "percent-equal";
	}

	private sealed class RowVm
	{
		public required List<string> Cells { get; init; }
		public required string Month { get; init; }
		public required string EffectiveYear { get; init; }
		public required bool IsTotal { get; init; }
	}

	private sealed class BlockData
	{
		public required string Title { get; init; }
		public required List<RowVm> Rows { get; init; }
	}

	private sealed class MonthlySourceRow
	{
		public required int Year { get; init; }
		public required int MonthOrder { get; init; }
		public required string Month { get; init; }
		public required double ProducedKwh { get; init; }
		public required double ConsumedKwh { get; init; }
		public required double FromGridKwh { get; init; }
		public required double ToGridKwh { get; init; }
		public required double ChargedKwh { get; init; }
		public required double DischargedKwh { get; init; }
		public required double Autonomy { get; init; }
		public required int DaysWithoutSocMax { get; init; }
		public required int DaysWithSocMin { get; init; }
	}
}

