@page "/bilan-energie"
@using AtmoceSolarApp.Services
@inject ExcelDailyReportService ExcelDailyReportService
@rendermode InteractiveServer

<PageTitle>Bilan énergie solaire</PageTitle>

<div class="container-fluid py-4">
	<h1 class="mb-4">Bilan énergie solaire</h1>

	@if (isLoading)
	{
		<div class="alert alert-info">Chargement...</div>
	}
	else if (blocks.Count == 0)
	{
		<div class="alert alert-warning">Aucune donnée de bilan énergie disponible.</div>
	}
	else
	{
		<div class="accordion bilan-accordion" id="bilanAccordion">
			@foreach (var block in blocks)
			{
				var isExpanded = expandedBlocks.Contains(block.Title);
				<div class="accordion-item bilan-accordion-item">
					<h2 class="accordion-header">
						<button 
							class="accordion-button @(!isExpanded ? "collapsed" : "")" 
							type="button" 
							@onclick="@(() => ToggleBlock(block.Title))">
							@block.Title
						</button>
					</h2>
					<div 
						id="collapse-@block.Title" 
						class="accordion-collapse collapse @(isExpanded ? "show" : "")" 
						data-bs-parent="#bilanAccordion">
						<div class="accordion-body p-0">
							<div class="table-responsive">
								<table class="table table-striped table-sm align-middle bilan-energie-table">
									<thead>
										<tr>
											<th style="width: 150px;">@headers[1]</th>
											@for (var i = 2; i < headers.Count; i++)
											{
												<th>@headers[i]</th>
											}
										</tr>
									</thead>
									<tbody>
										@foreach (var row in block.Rows)
										{
											<tr class="@(GetRowClass(row))">
												<td class="text-start @(row.IsTotal ? "fw-bold" : "")">
													@if (row.IsTotal)
													{
														<text>Total</text>
													}
													else
													{
														@row.Month
													}
												</td>

												@for (var i = 2; i < headers.Count; i++)
												{
													<td class="text-end @GetCellClass(row.Cells[i]) @(row.IsTotal ? "fw-bold" : "")">@row.Cells[i]</td>
												}
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>

@code {
	private List<string> headers = new();
	private List<BlockData> blocks = new();
	private bool isLoading = true;
	private HashSet<string> expandedBlocks = new();

	protected override async Task OnInitializedAsync()
	{
		var result = await ExcelDailyReportService.ReadSheetContentAsync("Bilan énergie", 16);

		// Normalize headers: rename "Colonne1" to "Année"
		headers = result.Headers.Select(h => 
			h.Equals("Colonne1", StringComparison.OrdinalIgnoreCase) ? "Année" : h
		).ToList();

		var displayRows = BuildDisplayRows(result.Rows, 16);
		blocks = BuildBlocksByYear(displayRows);

		// Expand current year block by default
		var currentYear = DateTime.Now.Year.ToString();
		var currentYearBlock = blocks.FirstOrDefault(b => b.Title == currentYear);
		if (currentYearBlock != null)
		{
			expandedBlocks.Add(currentYear);
		}
		else if (blocks.Count > 0)
		{
			// If current year not found, expand the last year in the list
			expandedBlocks.Add(blocks[blocks.Count - 1].Title);
		}

		isLoading = false;
	}

	private void ToggleBlock(string year)
	{
		if (expandedBlocks.Contains(year))
		{
			expandedBlocks.Remove(year);
		}
		else
		{
			expandedBlocks.Add(year);
		}
	}

	private static List<RowVm> BuildDisplayRows(List<List<string>> sourceRows, int expectedColumns)
	{
		var output = new List<RowVm>();
		var currentYear = string.Empty;

		foreach (var sourceRow in sourceRows)
		{
			var cells = new List<string>(sourceRow);
			while (cells.Count < expectedColumns)
			{
				cells.Add(string.Empty);
			}

			var rowYear = cells[0].Trim();
			var month = cells[1].Trim();

			if (!string.IsNullOrWhiteSpace(rowYear))
			{
				// Extract year even if it's prefixed with "Cumul"
				var yearOnly = System.Text.RegularExpressions.Regex.Match(rowYear, @"\d{4}").Value;
				if (!string.IsNullOrWhiteSpace(yearOnly))
				{
					currentYear = yearOnly;
				}
				else
				{
					currentYear = rowYear;
				}
			}

			var effectiveYear = currentYear;
			var isTotal = month.Contains("cumul", StringComparison.OrdinalIgnoreCase) || 
						  rowYear.Contains("cumul", StringComparison.OrdinalIgnoreCase);

			output.Add(new RowVm
			{
				Cells = cells,
				Month = CapitalizeFirstLetter(month),
				EffectiveYear = effectiveYear,
				IsTotal = isTotal
			});
		}

		return output;
	}

	private static string CapitalizeFirstLetter(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return value;
		}

		return char.ToUpper(value[0]) + value[1..];
	}

	private static List<BlockData> BuildBlocksByYear(List<RowVm> rows)
	{
		var blocksByYear = new Dictionary<string, List<RowVm>>();

		foreach (var row in rows)
		{
			if (!blocksByYear.ContainsKey(row.EffectiveYear))
			{
				blocksByYear[row.EffectiveYear] = new List<RowVm>();
			}
			blocksByYear[row.EffectiveYear].Add(row);
		}

		var blocks = new List<BlockData>();
		foreach (var year in blocksByYear.Keys)
		{
			blocks.Add(new BlockData { Title = year, Rows = blocksByYear[year] });
		}

		return blocks;
	}

	private static string GetRowClass(RowVm row)
	{
		if (row.IsTotal)
		{
			return "total-row";
		}
		return string.Empty;
	}

	private static string GetCellClass(string value)
	{
		var classes = new List<string>();

		if (value.Contains('%'))
		{
			classes.Add("percent-col");
			classes.Add(GetPercentStateClass(value));
		}

		return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
	}

	private static string GetPercentStateClass(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return string.Empty;
		}

		var normalized = value.Replace("%", string.Empty).Trim();
		if (!double.TryParse(normalized, System.Globalization.NumberStyles.Any, 
			System.Globalization.CultureInfo.GetCultureInfo("fr-FR"), out var percent)
			&& !double.TryParse(normalized, System.Globalization.NumberStyles.Any, 
			System.Globalization.CultureInfo.InvariantCulture, out percent))
		{
			return string.Empty;
		}

		var delta = percent - 100d;
		if (delta > 0)
		{
			if (delta >= 80) return "percent-high-3";
			if (delta >= 40) return "percent-high-2";
			return "percent-high-1";
		}

		if (delta < 0)
		{
			if (delta <= -80) return "percent-low-3";
			if (delta <= -40) return "percent-low-2";
			return "percent-low-1";
		}

		return "percent-equal";
	}

	private sealed class RowVm
	{
		public required List<string> Cells { get; init; }
		public required string Month { get; init; }
		public required string EffectiveYear { get; init; }
		public required bool IsTotal { get; init; }
	}

	private sealed class BlockData
	{
		public required string Title { get; init; }
		public required List<RowVm> Rows { get; init; }
	}
}
