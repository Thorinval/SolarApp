@page "/"
@using SolarApp.Models
@using SolarApp.Services
@inject SolarDataService SolarDataService
@inject ExcelDailyReportService ExcelDailyReportService
@inject AppRuntimeSettingsService AppRuntimeSettingsService
@inject ILogger<Home> Logger
@rendermode InteractiveServer

<PageTitle>Tableau de Bord - Suivi Solaire</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-5">
        <i class="bi bi-sun"></i> Tableau de Bord - Suivi Solaire
    </h1>

    <!-- Navigation Tiles -->
    <div class="navigation-tiles mb-5">
        <h2 class="mb-4">Navigation</h2>
        <div class="tiles-grid">
            <a href="/bilan-energie" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-lightning-fill"></i>
                </div>
                <div class="tile-content">
                    <h3>Bilan énergie solaire</h3>
                    <p>Analyse complète du bilan énergétique</p>
                </div>
            </a>

            <a href="/releve-quotidien-atmoce" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-calendar-day"></i>
                </div>
                <div class="tile-content">
                    <h3>Relevé quotidien Atmoce</h3>
                    <p>Données journalières détaillées</p>
                </div>
            </a>

            <a href="/releve-mensuel-atmoce" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="tile-content">
                    <h3>Relevé mensuel Atmoce</h3>
                    <p>Synthèse mensuelle des données</p>
                </div>
            </a>

            <a href="/releve-linky" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <div class="tile-content">
                    <h3>Relevé Linky</h3>
                    <p>Données du compteur Linky</p>
                </div>
            </a>

            <a href="/releve-hellowatt" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="tile-content">
                    <h3>Relevé Hellowatt</h3>
                    <p>Consommation électrique depuis Hellowatt</p>
                </div>
            </a>

            <a href="/donnees-ensoleillement" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-cloud-sun"></i>
                </div>
                <div class="tile-content">
                    <h3>Données ensoleillement</h3>
                    <p>Analyses d'ensoleillement et couverture solaire</p>
                </div>
            </a>

            <a href="/graphiques" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="tile-content">
                    <h3>Graphiques</h3>
                    <p>Visualisations et statistiques</p>
                </div>
            </a>

            <a href="/parametres" class="nav-tile">
                <div class="tile-icon">
                    <i class="bi bi-gear"></i>
                </div>
                <div class="tile-content">
                    <h3>Paramètres</h3>
                    <p>Configuration des tarifs et préférences</p>
                </div>
            </a>
        </div>
    </div>

    <section class="params-section mb-5">
        <h2 class="mb-3">Initialisation au lancement</h2>
        <div class="card p-3">
            <div class="mb-3">
                <label class="form-label d-block mb-2">Mettre à jour au lancement</label>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="btn-group" role="group" aria-label="Mettre à jour au lancement">
                        <button type="button" class="btn btn-sm @(startupSettings.UpdateOnLaunch ? "btn-outline-secondary" : "btn-primary")" @onclick="() => SetUpdateOnLaunchAsync(false)" disabled="@(isSavingStartupSettings || isResettingData || isClearingDatabase)">Non</button>
                        <button type="button" class="btn btn-sm @(startupSettings.UpdateOnLaunch ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetUpdateOnLaunchAsync(true)" disabled="@(isSavingStartupSettings || isResettingData || isClearingDatabase)">Oui</button>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetDataAsync" disabled="@(isImporting || isResettingData || isClearingDatabase || isSavingStartupSettings)">
                        @if (isResettingData)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
						<i class="bi bi-arrow-clockwise"></i> Charger les données
                    </button>

                    <button class="btn btn-sm btn-outline-danger" @onclick="ClearDatabaseAsync" disabled="@(isImporting || isResettingData || isClearingDatabase || isSavingStartupSettings)">
                        @if (isClearingDatabase)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <i class="bi bi-trash"></i> Vider la base de donnée
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="init-source-home">Source d'initialisation</label>
                <select id="init-source-home" class="form-select form-select-sm w-auto" style="min-width: 220px;" value="@startupSettings.InitializationSource" @onchange="OnInitializationSourceChanged" disabled="@(isSavingStartupSettings || isResettingData || isClearingDatabase)">
                    <option value="@InitializationSource.Database">Depuis la BDD</option>
                    <option value="@InitializationSource.Excel">Depuis Excel</option>
                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(startupSettingsMessage))
            {
                <div class="alert @(startupSettingsSaved ? "alert-success" : "alert-danger") mt-2 mb-0">@startupSettingsMessage</div>
            }
        </div>
    </section>

    <div class="daily-import-panel mb-5">
        <h2 class="mb-3">Import des données journalières Atmoce</h2>
        <p class="text-muted mb-3">
            Connexion à Atmoce Cloud puis lecture directe de la page de relevé quotidien.
            Les données Atmoce sont mises à jour dans l’application et les feuilles dépendantes (dont l’ensoleillement) sont recalculées automatiquement.
        </p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-outline-primary" @onclick="ImportFromAtmoceCloud" disabled="@(isImporting || isResettingData || isClearingDatabase)">
                @if (isImporting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <i class="bi bi-cloud-arrow-down"></i> Importer depuis Atmoce Cloud
            </button>
        </div>

        @if (isImporting || !string.IsNullOrWhiteSpace(importStatusMessage))
        {
            <div class="progress mt-3 import-progress" role="progressbar" aria-label="Progression import" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%">@((importStatusMessage ?? "Mise à jour en cours...") )</div>
            </div>
        }

        @if (showUpdateOkHint)
        {
            <div class="import-ok-hint mt-2">Maj ok</div>
        }

        @if (!string.IsNullOrWhiteSpace(importMessage))
        {
            <div class="alert @(isImportSuccess ? "alert-success" : "alert-danger") mt-3 mb-0" role="alert">
                @importMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(resetMessage))
        {
            <div class="alert @(resetSuccess ? "alert-success" : "alert-danger") mt-2 mb-0">@resetMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(importDataPreview))
        {
            <details class="import-preview mt-3" open>
                <summary>Aperçu des données récupérées depuis Atmoce Cloud</summary>

                @if (importPreviewRows.Count > 0)
                {
                    <div class="table-responsive import-preview-table-wrap mt-3">
                        <table class="table table-sm table-striped align-middle import-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var header in importPreviewHeaders)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in importPreviewRows)
                                {
                                    <tr>
                                        @for (var i = 0; i < row.Count; i++)
                                        {
                                            <td>@row[i]</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <pre class="mt-3">@importDataPreview</pre>
                }
            </details>
        }
    </div>

    <hr class="my-5" />

    <!-- Sites Data -->
    <h2 class="mb-4">Sites solaires</h2>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            Chargement des données...
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erreur :</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    else if (sites.Count == 0)
    {
        <div class="alert alert-warning">
            Aucun site trouvé. <a href="/sync">Synchroniser maintenant</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12 mb-3">
                <button class="btn btn-primary" @onclick="RefreshData" disabled="@(!startupSettings.UpdateOnLaunch || isLoading)">
                    <i class="bi bi-arrow-clockwise"></i> Actualiser les données
                </button>
                <a href="/sync" class="btn btn-secondary">
                    <i class="bi bi-cloud-arrow-down"></i> Synchroniser avec Atmoce
                </a>
            </div>
        </div>

        <div class="row">
            @foreach (var site in sites)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-map"></i> @site.Name
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <strong>État :</strong> 
                                @if (site.BuildState?.ToLower() == "completed")
                                {
                                    <span class="badge bg-success">Installé</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">En cours</span>
                                }
                            </p>
                            <p class="card-text">
                                <strong>Capacité solaire :</strong> @site.SolarCapacity.ToString("F2") kWp
                            </p>
                            <p class="card-text">
                                <strong>Capacité batterie :</strong> @site.BatteryCapacity.ToString("F2") kWh
                            </p>
                            <p class="card-text">
                                <strong>Zone horaire :</strong> @site.TimeZone
                            </p>

                            @if (lastSnapshots.ContainsKey(site.Id))
                            {
                                var snapshot = lastSnapshots[site.Id].FirstOrDefault();
                                @if (snapshot != null)
                                {
                                    <hr />
                                    <p class="card-text">
                                        <strong>Production solaire :</strong> 
                                        <span class="text-success">@snapshot.SolarGenerationPower W</span>
                                    </p>
                                    <p class="card-text">
                                        <strong>Production du jour :</strong> 
                                        @snapshot.DailySolarGeneration.ToString("F2") kWh
                                    </p>
                                    <p class="card-text">
                                        <strong>État batterie :</strong> 
                                        <span>@snapshot.BatterySOC.ToString("F0")% SOC</span>
                                    </p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            Dernière mise à jour : @snapshot.SnapshotTime.ToString("G")
                                        </small>
                                    </p>
                                }
                            }

                            <a href="/site/@site.Id" class="btn btn-sm btn-info mt-3">
                                <i class="bi bi-zoom-in"></i> Détails
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Site> sites = new();
    private Dictionary<int, List<SiteDataSnapshot>> lastSnapshots = new();
    private bool isLoading = true;
    private bool isImporting;
    private bool isImportSuccess;
    private bool showUpdateOkHint;
    private bool isSavingStartupSettings;
    private bool startupSettingsSaved;
    private bool isResettingData;
    private bool isClearingDatabase;
    private bool resetSuccess;
    private string? startupSettingsMessage;
    private string? resetMessage;
    private AppRuntimeSettings startupSettings = new()
    {
        UpdateOnLaunch = false,
        InitializationSource = InitializationSource.Database
    };
    private string? importStatusMessage;
    private string? importMessage;
    private string? importDataPreview;
    private List<string> importPreviewHeaders = new();
    private List<List<string>> importPreviewRows = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        startupSettings = await AppRuntimeSettingsService.GetSettingsAsync();
        await LoadDashboardDataAsync(forceLoad: false);
    }

    private async Task LoadDashboardDataAsync(bool forceLoad)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            sites = new List<Site>();
            lastSnapshots = new Dictionary<int, List<SiteDataSnapshot>>();

            if (!forceLoad && !startupSettings.UpdateOnLaunch)
            {
                return;
            }

            sites = await SolarDataService.GetSitesAsync();

            foreach (var site in sites)
            {
                var snapshots = await SolarDataService.GetSiteDataSnapshotsAsync(site.Id, 1);
                lastSnapshots[site.Id] = snapshots;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors du chargement des données");
            errorMessage = "Une erreur est survenue lors du chargement des données.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        if (!startupSettings.UpdateOnLaunch)
        {
            resetSuccess = true;
            resetMessage = $"[{DateTime.Now:HH:mm:ss}] Mise à jour au lancement est désactivée : aucun chargement exécuté.";
            sites = new List<Site>();
            lastSnapshots = new Dictionary<int, List<SiteDataSnapshot>>();
            return;
        }

        await LoadDashboardDataAsync(forceLoad: true);
    }

    private async Task ImportFromAtmoceCloud()
    {
        try
        {
            isImporting = true;
            showUpdateOkHint = false;
            importMessage = null;
            importDataPreview = null;
            importPreviewHeaders = new List<string>();
            importPreviewRows = new List<List<string>>();
            importStatusMessage = "Démarrage de l’import...";

            var progress = new Progress<string>(message =>
            {
                importStatusMessage = message;
                _ = InvokeAsync(StateHasChanged);
            });

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var result = await ExcelDailyReportService.ImportFromAtmoceCloudAsync(progress);
            isImportSuccess = result.Success;
            showUpdateOkHint = result.Success;
            importMessage = $"[{DateTime.Now:HH:mm:ss}] {result.Message}";
            importDataPreview = result.DataPreview;
            (importPreviewHeaders, importPreviewRows) = ParseImportPreview(result.DataPreview);
            importStatusMessage = result.Success ? "Import terminé." : result.Message;
        }
        catch (Exception ex)
        {
            isImportSuccess = false;
            showUpdateOkHint = false;
            importMessage = $"[{DateTime.Now:HH:mm:ss}] Erreur lors de l'import depuis Atmoce Cloud.";
            importStatusMessage = "Erreur lors de l'import.";
            Logger.LogError(ex, "Erreur lors de l'import Atmoce Cloud");
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ResetDataAsync()
    {
        resetMessage = null;
        resetSuccess = false;
        isResettingData = true;

        try
        {
            if (!startupSettings.UpdateOnLaunch)
            {
                sites = new List<Site>();
                lastSnapshots = new Dictionary<int, List<SiteDataSnapshot>>();
                resetSuccess = true;
                resetMessage = $"[{DateTime.Now:HH:mm:ss}] Mise à jour au lancement est désactivée : aucun chargement exécuté.";
                return;
            }

            if (startupSettings.InitializationSource == InitializationSource.Excel)
            {
                var importedCount = await SolarDataService.ImportDailyRecordsFromExcelAsync();
                resetSuccess = true;
                resetMessage = $"[{DateTime.Now:HH:mm:ss}] Réinitialisation depuis Excel terminée ({importedCount} date(s) importée(s)).";
            }
            else
            {
                resetSuccess = true;
                resetMessage = $"[{DateTime.Now:HH:mm:ss}] Réinitialisation depuis la BDD terminée.";
            }

            await LoadDashboardDataAsync(forceLoad: true);
        }
        catch (Exception ex)
        {
            resetSuccess = false;
            resetMessage = $"[{DateTime.Now:HH:mm:ss}] Erreur lors de la réinitialisation des données.";
            Logger.LogError(ex, "Erreur lors de la réinitialisation des données");
        }
        finally
        {
            isResettingData = false;
        }
    }

    private async Task ClearDatabaseAsync()
    {
        resetMessage = null;
        resetSuccess = false;
        isClearingDatabase = true;

        try
        {
            var deletedCount = await SolarDataService.ClearDatabaseRecordsAsync();
            sites = new List<Site>();
            lastSnapshots = new Dictionary<int, List<SiteDataSnapshot>>();
            resetSuccess = true;
            resetMessage = $"[{DateTime.Now:HH:mm:ss}] Base de données vidée ({deletedCount} enregistrement(s) supprimé(s)).";
        }
        catch (Exception ex)
        {
            resetSuccess = false;
            resetMessage = $"[{DateTime.Now:HH:mm:ss}] Erreur lors du vidage de la base de données.";
            Logger.LogError(ex, "Erreur lors du vidage de la base de données");
        }
        finally
        {
            isClearingDatabase = false;
        }
    }

    private async Task SetUpdateOnLaunchAsync(bool value)
    {
        if (startupSettings.UpdateOnLaunch == value)
        {
            startupSettingsSaved = true;
            startupSettingsMessage = $"[{DateTime.Now:HH:mm:ss}] Option déjà positionnée sur {(value ? "Oui" : "Non")}.";
            return;
        }

        startupSettings.UpdateOnLaunch = value;

        if (!value)
        {
            startupSettings.InitializationSource = InitializationSource.Database;
        }

        await PersistStartupSettingsAsync();

        if (!value)
        {
            sites = new List<Site>();
            lastSnapshots = new Dictionary<int, List<SiteDataSnapshot>>();
        }
    }

    private async Task OnInitializationSourceChanged(ChangeEventArgs args)
    {
        if (args.Value is null)
        {
            return;
        }

        if (!Enum.TryParse<InitializationSource>(args.Value.ToString(), true, out var source))
        {
            return;
        }

        if (startupSettings.InitializationSource == source)
        {
            return;
        }

        startupSettings.InitializationSource = source;
        await PersistStartupSettingsAsync(showMessage: false);
    }

    private async Task PersistStartupSettingsAsync(bool showMessage = true)
    {
        if (showMessage)
        {
            startupSettingsMessage = null;
            startupSettingsSaved = false;
        }

        isSavingStartupSettings = true;

        try
        {
            await AppRuntimeSettingsService.SaveSettingsAsync(startupSettings);
            startupSettingsSaved = true;
            if (showMessage)
            {
                startupSettingsMessage = $"[{DateTime.Now:HH:mm:ss}] Paramètres de lancement enregistrés.";
            }
        }
        catch (Exception ex)
        {
            startupSettingsSaved = false;
            if (showMessage)
            {
                startupSettingsMessage = $"[{DateTime.Now:HH:mm:ss}] Impossible d'enregistrer les paramètres de lancement.";
            }
            Logger.LogError(ex, "Erreur lors de la sauvegarde des paramètres de lancement");
        }
        finally
        {
            isSavingStartupSettings = false;
        }
    }

    private static (List<string> Headers, List<List<string>> Rows) ParseImportPreview(string? preview)
    {
        if (string.IsNullOrWhiteSpace(preview))
        {
            return (new List<string>(), new List<List<string>>());
        }

        var lines = preview
            .Split(new[] { Environment.NewLine }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (lines.Count == 0)
        {
            return (new List<string>(), new List<List<string>>());
        }

        var headers = lines[0]
            .Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .ToList();

        var rows = new List<List<string>>();
        foreach (var line in lines.Skip(1))
        {
            rows.Add(line
                .Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .ToList());
        }

        return (headers, rows);
    }
}

