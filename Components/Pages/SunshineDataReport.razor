@page "/donnees-ensoleillement"
@using System.Globalization
@using SolarApp.Services
@inject ExcelDailyReportService ExcelDailyReportService
@rendermode InteractiveServer

<PageTitle>Données ensoleillement</PageTitle>

<div class="container-fluid py-4">
	<h1 class="mb-4">Données ensoleillement</h1>

	@if (isLoading)
	{
		<div class="alert alert-info">Chargement...</div>
	}
	else if (rows.Count == 0)
	{
		<div class="alert alert-warning">Aucune donnée d’ensoleillement disponible.</div>
	}
	else
	{
		<div class="accordion sunshine-accordion" id="sunshineAccordion">
			@foreach (var block in blocks)
			{
				var isExpanded = expandedBlocks.Contains(block.Title);
				<div class="accordion-item sunshine-accordion-item">
					<h2 class="accordion-header">
						<button 
							class="accordion-button @(!isExpanded ? "collapsed" : "")" 
							type="button" 
							@onclick="@(() => ToggleBlock(block.Title))">
							@block.Title
						</button>
					</h2>
					<div 
						id="collapse-@block.Title.Replace(" ", "-")" 
						class="accordion-collapse collapse @(isExpanded ? "show" : "")" 
						data-bs-parent="#sunshineAccordion">
						<div class="accordion-body p-0">
							<div class="table-responsive">
								<table class="table table-striped table-sm align-middle sunshine-table">
									<thead>
										<tr>
											<th class="sticky-col">Mois</th>
											@foreach (var col in block.Columns)
											{
												<th>@GetHeader(col.ColumnIndex, col.Fallback)</th>
											}
										</tr>
									</thead>
									<tbody>
										@foreach (var row in rows)
										{
											var isTotal = IsTotalRow(row);
											<tr class="@(isTotal ? "table-secondary fw-bold" : string.Empty)">
												<td class="sticky-col text-start">@GetCell(row, 0)</td>
												@foreach (var col in block.Columns)
												{
													var rawValue = GetCell(row, col.ColumnIndex);
													var value = FormatCellValue(rawValue, col.IsPercent);
													var header = GetHeader(col.ColumnIndex, col.Fallback);
													<td class="@GetCellClass(value, header, col.IsPercent)">@value</td>
												}
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>

@code {
	private readonly List<BlockConfig> blocks =
	[
		new("Théorique initiale",
		[
			new(1, "Prod théorique (kWh)", false),
			new(2, "Prod théorique (index)", false),
			new(3, "Conso théorique (kWh)", false),
			new(4, "Couverture solaire théorique (%)", true)
		]),
		new("2026",
		[
			new(5, "Projection prod (kWh)", false),
			new(6, "Projection prod (index)", false),
			new(7, "Prod réelle (kWh)", false),
			new(8, "Prod réelle (index)", false),
			new(9, "Conso maison (kWh)", false),
			new(10, "Conso réseau (kWh)", false),
			new(11, "Couverture solaire réelle (%)", true),
			new(12, "Conso réseau (%)", true)
		]),
		new("2027",
		[
			new(13, "Projection prod (kWh)", false),
			new(14, "Projection prod (index)", false),
			new(16, "Prod réelle (kWh)", false),
			new(17, "Prod réelle (index)", false),
			new(18, "Conso maison (kWh)", false),
			new(19, "Conso réseau (kWh)", false),
			new(20, "Couverture solaire réelle (%)", true),
			new(21, "Conso réseau (%)", true)
		])
	];

	private List<string> headers = new();
	private List<List<string>> rows = new();
	private bool isLoading = true;
	private HashSet<string> expandedBlocks = new();

	protected override async Task OnInitializedAsync()
	{
		var result = await ExcelDailyReportService.ReadSheetContentAsync("Données ensoleillement");

		var filteredRows = new List<List<string>>();
		foreach (var row in result.Rows)
		{
			filteredRows.Add(row);
			if (IsTotalRow(row))
			{
				break;
			}
		}

		headers = result.Headers;
		rows = filteredRows;
		FillDerivedSunshineColumns();

		// Expand current year block by default (fallback to first block)
		if (blocks.Count > 0)
		{
			var currentYearTitle = DateTime.Now.Year.ToString(CultureInfo.InvariantCulture);
			var defaultBlock = blocks.FirstOrDefault(b => b.Title == currentYearTitle)?.Title ?? blocks[0].Title;
			expandedBlocks.Add(defaultBlock);
		}

		isLoading = false;
	}

	private void ToggleBlock(string blockTitle)
	{
		if (expandedBlocks.Contains(blockTitle))
		{
			expandedBlocks.Remove(blockTitle);
		}
		else
		{
			expandedBlocks.Add(blockTitle);
		}
	}

	private static string GetCell(IReadOnlyList<string> row, int index)
		=> index < row.Count ? row[index] : string.Empty;

	private static string FormatCellValue(string input, bool isPercentColumn)
	{
		if (string.IsNullOrWhiteSpace(input))
		{
			return string.Empty;
		}

		if (!TryParseCellNumber(input, out var numericValue))
		{
			return input.Trim();
		}

		var valueToRound = isPercentColumn && !input.Contains('%')
			? numericValue * 100d
			: numericValue;

		var rounded = Math.Round(valueToRound, 0, MidpointRounding.AwayFromZero);
		return rounded.ToString("0", CultureInfo.GetCultureInfo("fr-FR"));
	}

	private static bool IsTotalRow(IReadOnlyList<string> row)
		=> row.Count > 0 && row[0].Contains("Total", StringComparison.OrdinalIgnoreCase);

	private string GetHeader(int index, string fallback)
	{
		if (index < headers.Count)
		{
			var h = headers[index]?.Trim();
			if (!string.IsNullOrWhiteSpace(h))
			{
				return h;
			}
		}

		return fallback;
	}

	private static string GetCellClass(string value, string header, bool isPercentColumn)
	{
		var classes = new List<string> { "text-end" };

		if (isPercentColumn || value.Contains('%'))
		{
			classes.Add("percent-col");

			// Check for specific column types
			if (header.Contains("Conso réseau", StringComparison.OrdinalIgnoreCase))
			{
				classes.Add(GetConsoReseauClass(value));
			}
			else if (header.Contains("Couverture solaire", StringComparison.OrdinalIgnoreCase) || 
					 header.Contains("Prod réelle", StringComparison.OrdinalIgnoreCase))
			{
				classes.Add(GetRedYellowClass(value));
			}
			else
			{
				classes.Add(GetPercentStateClass(value));
			}
		}

		return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
	}

	private static string GetPercentStateClass(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return string.Empty;
		}

		var normalized = value.Replace("%", string.Empty).Trim();
		if (!double.TryParse(normalized, NumberStyles.Any, CultureInfo.GetCultureInfo("fr-FR"), out var percent)
			&& !double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out percent))
		{
			return string.Empty;
		}

		var delta = percent - 100d;
		if (delta > 0)
		{
			if (delta >= 80) return "percent-high-3";
			if (delta >= 40) return "percent-high-2";
			return "percent-high-1";
		}

		if (delta < 0)
		{
			if (delta <= -80) return "percent-low-3";
			if (delta <= -40) return "percent-low-2";
			return "percent-low-1";
		}

		return "percent-equal";
	}

	private static string GetConsoReseauClass(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return string.Empty;
		}

		var normalized = value.Replace("%", string.Empty).Trim();
		if (!double.TryParse(normalized, NumberStyles.Any, CultureInfo.GetCultureInfo("fr-FR"), out var percent)
			&& !double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out percent))
		{
			return string.Empty;
		}

		// Conso réseau: rouge foncé (valeur max) vers bleu clair (valeur min)
		// Supposons une échelle 0-100%
		if (percent >= 80) return "conso-reseau-high-3";
		if (percent >= 60) return "conso-reseau-high-2";
		if (percent >= 40) return "conso-reseau-mid";
		if (percent >= 20) return "conso-reseau-low-2";
		return "conso-reseau-low-3";
	}

	private static string GetRedYellowClass(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return string.Empty;
		}

		var normalized = value.Replace("%", string.Empty).Trim();
		if (!double.TryParse(normalized, NumberStyles.Any, CultureInfo.GetCultureInfo("fr-FR"), out var percent)
			&& !double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out percent))
		{
			return string.Empty;
		}

		// Couverture solaire et Prod réelle: rouge (valeur min) vers jaune (valeur max)
		// Supposons une échelle 0-100%
		if (percent >= 80) return "red-yellow-high-3";
		if (percent >= 60) return "red-yellow-high-2";
		if (percent >= 40) return "red-yellow-mid";
		if (percent >= 20) return "red-yellow-low-2";
		return "red-yellow-low-3";
	}

	private void FillDerivedSunshineColumns()
	{
		var theoreticalBlock = blocks.FirstOrDefault(b => b.Title.Equals("Théorique initiale", StringComparison.OrdinalIgnoreCase));
		var theoreticalProdColumn = theoreticalBlock?.Columns.FirstOrDefault(c => c.Fallback.Contains("Prod théorique", StringComparison.OrdinalIgnoreCase));
		var theoreticalProdIndexColumn = theoreticalBlock?.Columns.FirstOrDefault(c => c.Fallback.Contains("Prod théorique (index)", StringComparison.OrdinalIgnoreCase));

		var theoreticalProdByMonth = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
		var theoreticalProdIndexByMonth = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

		if (theoreticalProdColumn is not null)
		{
			foreach (var row in rows)
			{
				if (IsTotalRow(row))
				{
					break;
				}

				var month = GetCell(row, 0).Trim();
				if (string.IsNullOrWhiteSpace(month))
				{
					continue;
				}

				EnsureRowColumnCount(row, theoreticalProdColumn.ColumnIndex);
				theoreticalProdByMonth[month] = row[theoreticalProdColumn.ColumnIndex];

				if (theoreticalProdIndexColumn is not null)
				{
					EnsureRowColumnCount(row, theoreticalProdIndexColumn.ColumnIndex);
					theoreticalProdIndexByMonth[month] = row[theoreticalProdIndexColumn.ColumnIndex];
				}
			}
		}

		foreach (var block in blocks)
		{
			if (!int.TryParse(block.Title, NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
			{
				continue;
			}

			var projectionKwhColumn = block.Columns.FirstOrDefault(c => c.Fallback.Contains("Projection prod (kWh)", StringComparison.OrdinalIgnoreCase));
			var projectionIndexColumn = block.Columns.FirstOrDefault(c => c.Fallback.Contains("Projection prod (index)", StringComparison.OrdinalIgnoreCase));
			var consoMaisonColumn = block.Columns.FirstOrDefault(c => c.Fallback.Contains("Conso maison", StringComparison.OrdinalIgnoreCase));
			var consoReseauColumn = block.Columns.FirstOrDefault(c => c.Fallback.Contains("Conso réseau (kWh)", StringComparison.OrdinalIgnoreCase));
			var consoReseauPercentColumn = block.Columns.FirstOrDefault(c => c.Fallback.Contains("Conso réseau %", StringComparison.OrdinalIgnoreCase));

			if (consoMaisonColumn is null || consoReseauColumn is null || consoReseauPercentColumn is null)
			{
				continue;
			}

			foreach (var row in rows)
			{
				if (IsTotalRow(row))
				{
					break;
				}

				var month = GetCell(row, 0).Trim();

				if (projectionKwhColumn is not null)
				{
					EnsureRowColumnCount(row, projectionKwhColumn.ColumnIndex);
					if (string.IsNullOrWhiteSpace(row[projectionKwhColumn.ColumnIndex])
						&& !string.IsNullOrWhiteSpace(month)
						&& theoreticalProdByMonth.TryGetValue(month, out var theoreticalProd)
						&& !string.IsNullOrWhiteSpace(theoreticalProd))
					{
						row[projectionKwhColumn.ColumnIndex] = theoreticalProd;
					}
				}

				if (projectionIndexColumn is not null)
				{
					EnsureRowColumnCount(row, projectionIndexColumn.ColumnIndex);
					if (string.IsNullOrWhiteSpace(row[projectionIndexColumn.ColumnIndex])
						&& !string.IsNullOrWhiteSpace(month)
						&& theoreticalProdIndexByMonth.TryGetValue(month, out var theoreticalIndex)
						&& !string.IsNullOrWhiteSpace(theoreticalIndex))
					{
						row[projectionIndexColumn.ColumnIndex] = theoreticalIndex;
					}
				}

				EnsureRowColumnCount(row, consoMaisonColumn.ColumnIndex);
				EnsureRowColumnCount(row, consoReseauColumn.ColumnIndex);
				EnsureRowColumnCount(row, consoReseauPercentColumn.ColumnIndex);

				if (string.IsNullOrWhiteSpace(row[consoReseauPercentColumn.ColumnIndex])
					&& TryParseCellNumber(row[consoMaisonColumn.ColumnIndex], out var consoMaison)
					&& TryParseCellNumber(row[consoReseauColumn.ColumnIndex], out var consoReseau)
					&& consoMaison > 0)
				{
					var percent = (consoReseau / consoMaison) * 100;
					row[consoReseauPercentColumn.ColumnIndex] = $"{percent.ToString("0.##", CultureInfo.GetCultureInfo("fr-FR"))}%";
				}
			}
		}
	}

	private static void EnsureRowColumnCount(List<string> row, int index)
	{
		while (row.Count <= index)
		{
			row.Add(string.Empty);
		}
	}

	private static bool TryParseCellNumber(string input, out double value)
	{
		value = 0;
		if (string.IsNullOrWhiteSpace(input))
		{
			return false;
		}

		var normalized = input
			.Replace("kWh", string.Empty, StringComparison.OrdinalIgnoreCase)
			.Replace("%", string.Empty)
			.Trim();

		return double.TryParse(normalized, NumberStyles.Any, CultureInfo.GetCultureInfo("fr-FR"), out value)
			|| double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out value);
	}

	private sealed record ColumnConfig(int ColumnIndex, string Fallback, bool IsPercent);
	private sealed record BlockConfig(string Title, List<ColumnConfig> Columns);
}

